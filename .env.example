# Copy to .env and fill with real values, or just run:
#     python scripts/manage.py init-keys
#
# .env is gitignored. This file is committed so anyone cloning the repo knows
# which variables exist — it must never contain a real key.

VG_FIELD_KEY=CHANGEME
VG_INDEX_KEY=CHANGEME

# Optional whole-file encryption (pip install sqlcipher3-binary)
# VG_ENCRYPT_DB=1
# VG_DB_KEY=CHANGEME

VG_SESSION_TTL_HOURS=168
VG_SESSION_IDLE_HOURS=24
VG_MAX_FAILED_LOGINS=8
VG_LOCKOUT_MINUTES=15
VG_DEBUG=0

# --- email (optional) ---
#
# Without these the app runs in DEMO MODE: sign-in codes appear on screen
# instead of being emailed. Fine for a demo, not for real student work.
# Set them up interactively with:
#     python scripts/manage.py email-setup
#
# VG_SMTP_USER is a Gmail address; VG_SMTP_PASSWORD is a 16-character Google
# "app password" (Google Account -> Security -> App passwords), NOT the
# account's real password. It can be revoked on its own.
# VG_SMTP_USER=you@gmail.com
# VG_SMTP_PASSWORD=aaaabbbbccccdddd
# VG_MAIL_FROM_NAME=Veritagnosis
